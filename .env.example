# Required. Use a dedicated WeCom intelligent robot: only one active connection per Bot ID.
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_OWNER_USER_ID=
# Required comma-separated group chat IDs. Single chats are owner-only.
WECOM_ALLOWED_CHAT_IDS=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
# Configure exactly one verified downstream responder identity (never the bridge itself).
SLACK_REPLY_BOT_ID=
SLACK_REPLY_USER_ID=
STATE_DIR=./data
# Local limit only. Set within your tenant's actual active-message permissions/window.
REPLY_TTL_SECONDS=3600
MAX_MESSAGE_BYTES=32000

# Optional group attachments; OFF until scopes, CDN hosts, users and reader are approved.
WECOM_ATTACHMENTS_ENABLED=false
# Optional restriction. Empty allows authenticated members of the existing exact group allowlist.
WECOM_ATTACHMENT_ALLOWED_USER_IDS=
WECOM_ATTACHMENT_DOWNLOAD_HOSTS=
MAX_ATTACHMENTS_PER_MESSAGE=1
WECOM_ATTACHMENT_REPLIES_ENABLED=false

# Optional durable source feedback; empty repository allowlist keeps it OFF.
# Reuse the existing verified responder bot and additionally pin its actual Slack user.
FEEDBACK_ALLOWED_REPOSITORIES=
FEEDBACK_REPLY_USER_ID=

# Optional direct receipt HTTP ingress; OFF, no listener or credentials by default.
# Enabling requires separately approved network trust and exact bind/client/repo settings.
# See docs/HTTP_RECEIPTS.md. No application identity authentication is provided.
RECEIPT_HTTP_ENABLED=false
RECEIPT_HTTP_TRUST_NETWORK=false
RECEIPT_HTTP_HOST=
RECEIPT_HTTP_PORT=
RECEIPT_HTTP_CLIENT_IPS=
RECEIPT_HTTP_REPOSITORIES=
